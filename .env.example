# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=locim
POSTGRES_PASSWORD=locim
POSTGRES_DB=locim

JWT_SECRET=change-me-to-a-long-random-string

# Groq (https://console.groq.com). Leave empty to use the deterministic mock AI.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# PayPal Sandbox (developer.paypal.com > Apps & Credentials > Sandbox). Never use live credentials here.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Money. Projects are priced in DEFAULT_CURRENCY (must be a currency your PayPal accounts hold).
# The platform fee is added on top of every milestone; the freelancer is paid the full milestone amount.
DEFAULT_CURRENCY=PHP
PLATFORM_FEE_RATE=0.10
